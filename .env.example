# Nebius Token Factory (OpenAI-compatible endpoint).
# Confirm the exact base URL shown in your Nebius dashboard when you create the key;
# some regions use a region-suffixed host (e.g. api.tokenfactory.us-central1.nebius.com).
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tavily web search (the web-grounding that makes LiveFix work on fresh API changes).
TAVILY_API_KEY=

# LangSmith tracing (optional). When both LANGSMITH_TRACING is truthy and
# LANGSMITH_API_KEY is set, each run, model call and search call is traced to
# LangSmith. Leave these blank to run with no tracing and no extra dependency.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=livefix
